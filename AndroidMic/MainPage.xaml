<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AndroidMic.MainPage"
             Loaded="ContentPage_Loaded"
             BackgroundColor="{DynamicResource PageBackgroundColor}">
    <ScrollView Orientation="Vertical">

        <VerticalStackLayout Margin="20,20,20,20"
                             Spacing="20">

            <Grid HeightRequest="50"
                  ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="25" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        x:Name="ConnectButton"
                        Text="Connect"
                        Clicked="ConnectButton_Clicked">
                </Button>
                <Border Grid.Column="1"
                        x:Name="ConnectionStateBadge"
                        WidthRequest="25"
                        HeightRequest="25"
                        Stroke="DarkSlateGray"
                        StrokeThickness="2.5"
                        Background="DarkRed"
                        HorizontalOptions="End">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                </Border>
            </Grid>
            <Label x:Name="VolumeLabel"
                   Text="Volume: 0%"
                   FontSize="16"
                   HorizontalOptions="Center" />

            <Border Stroke="BlueViolet">
                <HorizontalStackLayout HeightRequest="200"
                                       SizeChanged="SlidersStackLayout_SizeChanged"
                                       x:Name="SlidersStackLayout"
                                       HorizontalOptions="Center">
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>